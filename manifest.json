{
  "manifest_version": 3,
  "name": "JiraLogWork",
  "version": "1.0.0",
  "description": "Quick Jira worklogs and a full calendar view.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://*.atlassian.net/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Add today's worklog",
    "default_popup": "popup.html"
  },
  "options_page": "calendar.html"
}
